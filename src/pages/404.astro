---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="页面不存在">
  <div class="not-found">
    <h1>404</h1>
    <p>这个页面不在了，可能是链接写错了。</p>
    <a href={base}>回到首页</a>
  </div>
</BaseLayout>
